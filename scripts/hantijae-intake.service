[Unit]
Description=hantijae intake worker (telegram long-polling + drive polling)
After=network-online.target mysqld.service
Wants=network-online.target mysqld.service

[Service]
Type=simple
User=ec2-user
Group=ec2-user
Environment=MODE=prod
Environment=HOME=/home/ec2-user
Environment=PYTHONUNBUFFERED=1
# 입체 대안 이미지 등 초안 파일이 재부팅·tmp 정리로 사라지지 않게 홈 아래에 둔다
Environment=INTAKE_WORK_DIR=/home/ec2-user/hantijae-intake
WorkingDirectory=/home/ec2-user/hantijae-bookstore/django/hantijae_bookstore
ExecStart=/home/ec2-user/.pyenv/versions/hantijae-bookstore/bin/python manage.py intake_worker
Restart=always
RestartSec=10
# 1GB 서버(+스왑 1GB): 큰 이미지 처리 중 메모리가 튀면 MySQL 대신 워커가 죽도록 상한을 둔다.
# 죽은 입력은 telegram_inflight·attempts 로 건너뛰어 재시작 루프가 되지 않는다.
MemoryMax=450M
NoNewPrivileges=true
ProtectSystem=full
# uWSGI와 같은 /var/tmp 캐시 디렉터리를 공유해야 하므로 PrivateTmp 끔
PrivateTmp=false

[Install]
WantedBy=multi-user.target
